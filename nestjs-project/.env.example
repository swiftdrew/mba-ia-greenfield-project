# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=streamtube
DB_NAME=streamtube

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CONFIRMATION_TOKEN_EXPIRATION_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# Mail (Mailpit for local development)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM=noreply@streamtube.com

# Object Storage (MinIO - S3 compatible)
STORAGE_ENDPOINT=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=streamtube
STORAGE_SECRET_KEY=streamtube123
STORAGE_FORCE_PATH_STYLE=true
STORAGE_VIDEOS_BUCKET=videos
STORAGE_THUMBNAILS_BUCKET=thumbnails
STORAGE_SIGNED_URL_EXPIRES_IN_SECONDS=3600

# Queue (BullMQ + Redis)
QUEUE_HOST=redis
QUEUE_PORT=6379
QUEUE_DB=0
QUEUE_PASSWORD=
QUEUE_VIDEO_PROCESSING_NAME=video-processing
QUEUE_VIDEO_PROCESSING_CONCURRENCY=2
